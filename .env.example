# VITE_SUPABASE_URL: Public Supabase project URL (safe for the browser)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public anonymous key (safe for the browser; RLS still applies)
VITE_SUPABASE_ANON_KEY="your-anon-key"

# VITE_PUBLIC_URL: Canonical public origin used by QR codes, share buttons
# and Open Graph metadata. Defaults to https://skillproof.top in prod, or
# window.location.origin in dev.
VITE_PUBLIC_URL="https://skillproof.top"

# SUPABASE_URL: Server-side Supabase project URL (usually same as VITE_SUPABASE_URL)
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Server-only key. NEVER prefix with VITE_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# GROQ_API_KEY: Server-only. Required for Universal Assessment generation.
GROQ_API_KEY="your-groq-api-key"

# GEMINI_API_KEY: Server-only. Optional fallback for CV extraction only.
GEMINI_API_KEY="your-gemini-api-key"

# PUBLIC_URL: Server-side canonical origin used by the /api/og/* route.
# Mirrors VITE_PUBLIC_URL when set, otherwise defaults to skillproof.top.
PUBLIC_URL="https://skillproof.top"

# APP_URL / CORS_ORIGIN: Public production URL and allowed browser origin.
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Optional server configuration
PORT="3000"
SUPER_ADMIN_EMAIL="admin@example.com"
