
# ============================================================================
# SECURITY HARDENING (Phase 1): this file MUST NOT contain real secrets.
# Real values go into .env (gitignored) on each developer machine and on
# the cPanel deployment host. The previous version of this file shipped
# real values; they have been replaced with placeholders below.
# ============================================================================

# Public Supabase URL (safe for the browser).
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Public anonymous key (safe for the browser; RLS still applies).
VITE_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Public origin used by QR codes, share buttons, and Open Graph metadata.
VITE_PUBLIC_URL="https://YOUR-DOMAIN"

# Backend origin. Leave empty to use the hardcoded production default
# (https://skillproof.top/skillproof-api/api — the PHP AI Gateway).
# Set to an absolute URL to point at a staging PHP backend.
VITE_API_URL=""

# Designated super admin email — sourced by AdminUsersPage at runtime.
# If left unset, the bundled fallback is used (development only).
VITE_SUPER_ADMIN_EMAIL="your-super-admin@example.com"

# ============================================================================
# PHP AI Gateway config — copied into public_html/skillproof-api/.env
# The values are already hardcoded as fallbacks inside _bootstrap.php, so
# the PHP API works WITHOUT this file. Only set these in the .env you drop
# into public_html/skillproof-api/ if you want to override the defaults.
#
# SECURITY HARDENING (Phase 1): leave these EMPTY in this committed file.
# They MUST come from the deployment host's environment-specific .env.
# ============================================================================

# Server-side Supabase project URL.
SUPABASE_URL=""

# Server-side service role key (NEVER prefix with VITE_).
SUPABASE_SERVICE_ROLE_KEY=""

# Server-side Groq API key (the AI provider).
GROQ_API_KEY=""

# Optional. First account with this email gets super_admin role.
SUPER_ADMIN_EMAIL=""
